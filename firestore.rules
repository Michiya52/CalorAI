rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: verify ownership
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. User Profiles — only the owning user can read/write
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      
      // 2. User Meals — scoped to owning user
      match /meals/{mealId} {
        allow read, write: if isOwner(uid);
      }

      // 3. User Weight Logs — scoped to owning user
      match /weight_logs/{logId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 4. Global Food Database — read-only for anyone, write for initial seeding
    match /foods/{foodId} {
      // Allow read access to anyone (even if not authenticated) so the app 
      // can check if seeding is needed at startup.
      allow read: if true;
      // Allow write-access temporarily for initial seeding; this should be 
      // strictly controlled in a production environment.
      allow write: if true; 
    }
  }
}
