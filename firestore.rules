rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper: check if user is logged in
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper: verify ownership
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // 1. User Profiles — only the owning user can read/write
    match /users/{uid} {
      allow read, write: if isOwner(uid);
      
      // 2. User Meals — scoped to owning user
      match /meals/{mealId} {
        allow read, write: if isOwner(uid);
      }

      // 3. User Weight Logs — scoped to owning user
      match /weight_logs/{logId} {
        allow read, write: if isOwner(uid);
      }
    }

    // 4. Global Food Database — retired. The app now ships its food data as
    //    a bundled asset (assets/data/myfcd_full.json); client-side seeding
    //    has been removed. Locked down so no client can wipe or spam it.
    match /foods/{foodId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
